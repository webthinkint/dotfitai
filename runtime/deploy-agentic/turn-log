#!/usr/bin/env python3
"""turn-log — the request/response view of the dotfit-agentic-service journal.

Design §10: every request writes exactly one `dotfit.turn` JSON line to the
service's stdout — what the model did, never what it or the customer said —
and the service runs as a systemd *user* unit, so the journal holds those
lines interleaved with the host's own console logging. This command picks the
turns out and prints one readable line per request. It is the sibling of v1's
`verdict-log` (runtime/deploy/verdict-log), reading the sibling unit's journal
— same shape, different schema, because the two logs answer different
questions: v1's reconstructed what a gate decided, this one reconstructs what
an ungated loop actually did (§8.3 — with nothing withheld, the log is the
record of what an audience was shown).

The default line leads with the number this branch exists for (§6): time to
first delta, then total. Around it, only the fields that carry news — tools
called, searches issued, budget stops, sources vs citations, families, token
counts.

`--transcripts` switches to the debug transcript log
(`dotfit.agentic.transcript`, the opt-in DOTFIT_AGENTIC_DEBUG_TRANSCRIPT
record the preview unit enables): one block per request with the question, the
tool calls and the full answer — the words the turn log structurally cannot
carry. Transcripts hold the words themselves (owner ruling 2026-09-11,
preview-only), so treat the output like customer data.

Lines that are not turns/transcripts — boot banners, ASP.NET host logs — are
filtered **by journalctl itself** (`--grep`), which is also what makes
`-n N` mean "the last N turns" rather than "the last N journal lines". The
`schema` tag is verified on the parsed record too, and a line without it is
never printed, `--raw` included, so `--raw` is safe to hand to a collector.

Usage:
    turn-log [options] [-- extra journalctl args]

Options:
    -f, --follow    keep streaming as requests finish (journalctl -f)
    --raw           one JSON line per record, untouched
    --queries       (turns) print the search texts in full rather than the
                    first 30 characters of each
    --transcripts   show the debug transcript log instead of the turns
    --utc           timestamps in UTC rather than local time
    --unit NAME     unit to read (default dotfit-agentic-service.service)

Anything after the options is passed to journalctl verbatim, so the usual
selections work: `turn-log -n 50` (last 50 turns), `turn-log --since
"1 hour ago"`, `turn-log -b`, `turn-log --transcripts -n 5`. Requires a
journalctl with PCRE2 support for --grep (systemd ≥ 236).

install-user-service.sh installs this as ~/.local/bin/dotfit-turn-log.
Stdlib only — no jq, no uv — because it runs on the preview VM, not in the
pipeline's environment.
"""

import argparse
import json
import os
import subprocess
import sys
from datetime import datetime

DEFAULT_UNIT = "dotfit-agentic-service.service"
TURN_TAG = "dotfit.turn"
TRANSCRIPT_TAG = "dotfit.agentic.transcript"

# Widest of the turn outcomes, so the column lines up for scanning.
OUTCOME_WIDTH = 9

# Search texts are model text (open item 3, owner-ruled loggable) but they can
# run long; the traffic view clips them, --queries shows them whole.
QUERY_CLIP = 30


def fmt_ms(ms):
    """Seconds with one decimal past ten seconds, milliseconds under it."""
    return f"{ms / 1000:.1f}s" if ms >= 10_000 else f"{ms:.0f}ms"


def render_ts(iso, utc):
    try:
        dt = datetime.fromisoformat(iso)
    except (TypeError, ValueError):
        return iso or "?"
    if not utc:
        dt = dt.astimezone()
    return dt.strftime("%Y-%m-%d %H:%M:%S")


def turn_line(entry, show_queries, utc):
    """One line per turn: fixed head, then only the fields that carry news."""
    detail = []

    if entry.get("error_kind"):
        detail.append(f"error={entry['error_kind']}")

    tools_used = entry.get("tools_used") or {}
    if tools_used:
        detail.append("tools={" + ",".join(
            f"{tool}:{n}" for tool, n in tools_used.items()) + "}")

    queries = entry.get("queries") or []
    if queries:
        if show_queries:
            detail.append("q=[" + " | ".join(queries) + "]")
        else:
            detail.append("q=[" + " | ".join(
                q if len(q) <= QUERY_CLIP else q[:QUERY_CLIP - 1] + "…"
                for q in queries) + "]")
    if entry.get("budget_exhausted"):
        # A §6 budget refusal: the model wanted another call and did not get
        # one. The answer still went out — that is D3 — so this is the flag
        # that says "read this transcript".
        detail.append("BUDGET-STOP")

    n_sources, n_cited = entry.get("sources", 0), entry.get("cited", 0)
    if n_sources or n_cited:
        detail.append(f"src={n_sources} cit={n_cited}")
    authorities = entry.get("cited_authorities") or []
    if authorities:
        detail.append("auth=[" + ",".join(str(a) for a in authorities) + "]")
    families = entry.get("families") or []
    if families:
        detail.append("fam=[" + ",".join(families) + "]")

    # Multi-turn: what a turn rested on is only visible with the id join.
    if entry.get("history_turns"):
        detail.append(f"hist={entry['history_turns']}")

    tokens_in, tokens_out = entry.get("input_tokens"), entry.get("output_tokens")
    if tokens_in is not None or tokens_out is not None:
        detail.append(f"tok={tokens_in or 0}/{tokens_out or 0}")

    head = [
        render_ts(entry.get("ts"), utc),
        entry.get("request_id", "?"),
        f"{entry.get('outcome', '?'):<{OUTCOME_WIDTH}}",
    ]
    # The latency pair closes the line: first delta / total (§6's two targets,
    # in the order the branch cares about them).
    latency = f"{fmt_ms(entry.get('first_delta_ms', 0))}/{fmt_ms(entry.get('total_ms', 0))}"
    return " ".join(head + detail) + " " + latency


def transcript_block(entry, utc):
    """The what-did-it-actually-say view: one indented block per request.

    Written for the question the owner actually asks after a bad turn — "what
    did it look up and what did it then say" — because nothing on this branch
    withheld or repaired anything: the transcript *is* what the customer saw.
    """
    request_id = entry.get("request_id", "?")
    head = "── " + render_ts(entry.get("ts"), utc) + "  " + request_id

    lines = [head]
    lines.append("Q: " + entry.get("question", "?").replace("\n", "\n   "))
    for call in entry.get("tool_calls") or []:
        line = f"  {call.get('tool', '?')} \"{call.get('argument', '')}\""
        if call.get("results") is not None:
            line += f" → {call['results']} results"
        if call.get("elapsed_ms") is not None:
            line += f" ({fmt_ms(call['elapsed_ms'])})"
        lines.append(line)
        if call.get("refusal"):
            lines.append(f"    refused: {call['refusal']}")

    if entry.get("answer"):
        lines.append("answer:")
        lines.append("  " + entry["answer"].replace("\n", "\n  "))
    cited = entry.get("cited") or []
    if cited:
        lines.append("cited: [" + ",".join(str(n) for n in cited) + "]")

    return "\n".join(lines)


def main():
    parser = argparse.ArgumentParser(
        prog="turn-log",
        description="Show only the dotfit.turn / dotfit.agentic.transcript "
            "lines from the agentic service journal.",
        epilog="Anything unrecognized is passed to journalctl verbatim "
            "(e.g. -n 50, --since '…', -b, --grep).",
        add_help=True,
    )
    parser.add_argument("-f", "--follow", action="store_true",
                        help="keep streaming as requests finish")
    parser.add_argument("--raw", action="store_true",
                        help="one JSON line per record, untouched")
    parser.add_argument("--queries", action="store_true",
                        help="(turns) print the search texts in full")
    parser.add_argument("--transcripts", action="store_true",
                        help="show the debug transcript log instead of the turns")
    parser.add_argument("--utc", action="store_true",
                        help="timestamps in UTC rather than local time")
    parser.add_argument("--unit", default=os.environ.get(
        "DOTFIT_TURN_UNIT", DEFAULT_UNIT),
                        help=f"unit to read (default {DEFAULT_UNIT})")
    args, passthrough = parser.parse_known_args()

    # A user unit is only addressable with a runtime dir; ssh logins have it,
    # cron-adjacent shells sometimes do not (same fallback as the install
    # script).
    os.environ.setdefault("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}")

    tag = TRANSCRIPT_TAG if args.transcripts else TURN_TAG
    # journalctl does the line filtering, so -n N counts *matching* lines; the
    # tag is still verified per record below, so spacing changes on the wire
    # cannot let a host line through as a turn.
    cmd = ["journalctl", "--user", "-u", args.unit, "-o", "cat", "--no-pager",
           "--grep", f'"{tag}"']
    if args.follow:
        cmd.append("-f")
    cmd += passthrough

    proc = subprocess.Popen(cmd, stdout=subprocess.PIPE, text=True)
    try:
        for line in proc.stdout:
            line = line.strip()
            if f'"{tag}"' not in line:
                continue
            try:
                entry = json.loads(line)
            except json.JSONDecodeError:
                continue
            if not isinstance(entry, dict) or entry.get("schema") != tag:
                continue
            if args.raw:
                print(line, flush=True)
            elif args.transcripts:
                print(transcript_block(entry, args.utc), flush=True)
                print(flush=True)
            else:
                print(turn_line(entry, args.queries, args.utc), flush=True)
        proc.wait()
    except BrokenPipeError:
        # Piping into `head` and friends is a normal exit, not a traceback.
        proc.stdout.close()
        proc.wait()
        sys.exit(0)


if __name__ == "__main__":
    main()
