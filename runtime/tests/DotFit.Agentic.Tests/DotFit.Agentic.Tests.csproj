<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!--
      Minimal by decision, not by neglect (design §11, D7). The deterministic
      tool layer is pinned because it has a right answer; the loop gets shape
      tests for the failures that would otherwise be silent. This is not a port
      of v1's 264 tests and should not grow into one.

      Hermetic: scripted IChatClient fakes and synthetic fixtures. No Azure.
    -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\DotFit.Agentic\DotFit.Agentic.csproj" />
    <ProjectReference Include="..\..\src\DotFit.Agentic.Cli\DotFit.Agentic.Cli.csproj" />
    <ProjectReference Include="..\..\src\DotFit.Agentic.Service\DotFit.Agentic.Service.csproj" />
  </ItemGroup>

</Project>
