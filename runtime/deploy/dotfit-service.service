# dotfit-service — systemd *user* unit for the preview VM.
#
# install-user-service.sh installs this file into ~/.config/systemd/user/ with
# the paths below substituted for the actual repo/home, so it is safe to commit
# with this VM's paths spelled out.
#
# Transport only; the loop is DotFit.Assistant. Hardening lives in
# ServiceOptions, not here — fail-closed on the shared secret.
[Unit]
Description=dotFIT assistant SSE service
After=network-online.target

[Service]
# Repo root, so the .env walk-up finds the .env, and everything resolved beside
# it (the alias table, assistant/prompt, assistant/sources.yaml) is found
# without extra config. Prompt and reference edits take effect on restart.
WorkingDirectory=/home/kovach/dotfitai
ExecStart=/home/kovach/.local/share/dotfit/service/dotfit-service
# Internal-network bind.
Environment=ASPNETCORE_URLS=http://0.0.0.0:5299
# Debug transcript logging, preview only: the service writes one
# dotfit.transcript line per request — question, tool calls, full answer —
# because with nothing gated the text-free turn log cannot say what a bad turn
# actually said.
# Remove this line before public customer traffic: off is the default, and the
# boot line + /healthz say the state either way.
Environment=DOTFIT_ASSISTANT_DEBUG_TRANSCRIPT=1
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
