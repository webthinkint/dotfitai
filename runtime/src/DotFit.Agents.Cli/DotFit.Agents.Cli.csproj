<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>DotFit.Agents.Cli</RootNamespace>
    <!-- The exe is `dotfit-agent` — the library keeps its own assembly name. -->
    <AssemblyName>dotfit-agent</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DotFit.Agents\DotFit.Agents.csproj" />
  </ItemGroup>

</Project>
