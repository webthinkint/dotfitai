<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>DotFit.Agents.Service</RootNamespace>
    <AssemblyName>dotfit-agent-service</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- ServiceOptions.FromValues, so the hardening contract is testable
         without a host — same arrangement DotFit.Agents has for RuntimeOptions. -->
    <InternalsVisibleTo Include="DotFit.Agents.Tests" />
    <ProjectReference Include="..\DotFit.Agents\DotFit.Agents.csproj" />
  </ItemGroup>

</Project>
