<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>DotFit.Agentic.Service</RootNamespace>
    <AssemblyName>dotfit-agentic-service</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- AgenticServiceOptions.FromValues and the event mapping, so the wire
         contract is testable without a host. -->
    <InternalsVisibleTo Include="DotFit.Agentic.Tests" />
    <ProjectReference Include="..\DotFit.Agentic\DotFit.Agentic.csproj" />
  </ItemGroup>

</Project>
