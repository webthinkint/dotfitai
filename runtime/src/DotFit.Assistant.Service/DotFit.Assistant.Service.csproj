<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>DotFit.Assistant.Service</RootNamespace>
    <AssemblyName>dotfit-service</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- ServiceOptions.FromValues and the event mapping, so the wire
         contract is testable without a host. -->
    <InternalsVisibleTo Include="DotFit.Assistant.Tests" />
    <ProjectReference Include="..\DotFit.Assistant\DotFit.Assistant.csproj" />
  </ItemGroup>

</Project>
