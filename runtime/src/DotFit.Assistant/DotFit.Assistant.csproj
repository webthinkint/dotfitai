<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>DotFit.Assistant</RootNamespace>
    <!--
      Azure.AI.OpenAI stays on the prerelease line on purpose: the stable GA
      build only offers api-version 2024-10-21, which the Foundry v2 resource
      404s. Microsoft.Extensions.AI supplies AIFunctionFactory: the tools are
      plain C# delegates and the Agent Framework's function-invoking decorator
      runs the loop over them.
    -->
  </PropertyGroup>

  <ItemGroup>
    <!-- Tests reach the deterministic layer: source numbering, OData filter
         builders, budget enforcement, currency-fact rendering. -->
    <InternalsVisibleTo Include="DotFit.Assistant.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Azure.AI.OpenAI" Version="2.9.0-beta.1" />
    <PackageReference Include="Azure.Search.Documents" Version="12.0.0" />
    <PackageReference Include="Microsoft.Agents.AI" Version="1.20.0" />
    <PackageReference Include="Microsoft.Agents.AI.OpenAI" Version="1.20.0" />
    <PackageReference Include="Microsoft.Extensions.AI" Version="10.9.0" />
    <PackageReference Include="YamlDotNet" Version="18.1.0" />
  </ItemGroup>

</Project>
