# Committed template of the local secrets contract. Copy to `.env` (gitignored)
# and fill in real values there — never here.
#   cp .env.example .env
# Consumed by pipeline/src/qa_pipeline/azure_config.py and the runtime config
# loader (runtime/src/DotFit.Agents/Config/EnvFile.cs — a line-for-line mirror).
# Both validate shape and never echo values (errors name the variable only).
# The runtime prefers AZURE_SEARCH_QUERY_KEY and falls back to the admin key;
# AZURE_OPENAI_SMALL_CHAT_DEPLOYMENT falls back to AZURE_OPENAI_CHAT_DEPLOYMENT.

# --- Azure AI Search --------------------------------------------------------
AZURE_SEARCH_ENDPOINT=https://<your-search-name>.search.windows.net
AZURE_SEARCH_ADMIN_KEY=
# Optional until the query-only answer service exists.
AZURE_SEARCH_QUERY_KEY=

# --- Azure OpenAI -----------------------------------------------------------
# Foundry v2 resources use https://<your-resource-name>.services.ai.azure.com
# (classic *.openai.azure.com also works where still provisioned).
AZURE_OPENAI_ENDPOINT=https://<your-openai-name>.services.ai.azure.com
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_CHAT_DEPLOYMENT=
AZURE_OPENAI_SMALL_CHAT_DEPLOYMENT=
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=

# --- Azure AI Speech (podcast ASR, plan §7) ---------------------------------
AZURE_SPEECH_ENDPOINT=
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# --- SSE service hardening (runtime only, plan §11 / open item 22) -----------
# Read by runtime/src/DotFit.Agents.Service; the Python pipeline ignores them.
# The service has no auth of its own: it expects a private network and this
# shared secret, sent as `Authorization: Bearer <secret>` on POST /ask. A
# missing key fails the *boot* rather than the first question — an open endpoint
# that answers anyway is the one mistake this service cannot survive. At least
# 16 characters.
DOTFIT_SERVICE_API_KEY=
# Only value accepted is `none`, and only when something in front of the service
# authenticates the caller (mTLS) or for a local smoke. Setting it alongside
# DOTFIT_SERVICE_API_KEY is an error — one of the two would be a mistake and
# guessing which would either expose the service or reject the caller.
DOTFIT_SERVICE_AUTH=
# Optional limits; defaults 2000 and 120. A longer question is a 400, never a
# truncation — truncating changes the question that gets answered.
DOTFIT_SERVICE_MAX_QUESTION_CHARS=
DOTFIT_SERVICE_TIMEOUT_SECONDS=
# Where the refusal / withheld handoffs send a customer. Unset uses the
# PDSRG-attested route (support@dotfit.com or (877) 436-8348); `none` drops the
# line and leaves the prose alone. Used by the CLI too, not just the service.
DOTFIT_SUPPORT_CONTACT=

# --- Per-turn cost pricing (agentic runtime, result.cost) --------------------
# The prices `result.cost` and the turn log's `cost` block are priced against.
# Usage counts (tokens, index queries) come back from the APIs; these turn
# them into currency. Defaults are the built-in placeholder sheet
# (id `builtin-2026-09`): the chat trio mirrors the current frontier list
# prices, embedding is text-embedding-3-large's, and the search rate is a
# DUMMY until real cost data replaces it — a provisioned AI Search tier bills
# the month, not the query. Override all of them when the deployment or prices
# change, and set DOTFIT_PRICE_SHEET to a new id in the same .env edit: every
# emitted cost names its sheet, which is what keeps old numbers interpretable.
DOTFIT_PRICE_CHAT_INPUT_PER_1M=1.25
DOTFIT_PRICE_CHAT_CACHED_INPUT_PER_1M=0.125
DOTFIT_PRICE_CHAT_OUTPUT_PER_1M=10
DOTFIT_PRICE_EMBEDDING_PER_1M=0.13
DOTFIT_PRICE_SEARCH_PER_1K=0.25
DOTFIT_PRICE_CURRENCY=USD
DOTFIT_PRICE_SHEET=builtin-2026-09
