# Committed template of the local secrets contract. Copy to `.env` (gitignored)
# and fill in real values there — never here.
#   cp .env.example .env
# Consumed by pipeline/src/qa_pipeline/azure_config.py, which validates shape
# and never echoes values (errors name the variable only).

# --- Azure AI Search --------------------------------------------------------
AZURE_SEARCH_ENDPOINT=https://<your-search-name>.search.windows.net
AZURE_SEARCH_ADMIN_KEY=
# Optional until the query-only answer service exists.
AZURE_SEARCH_QUERY_KEY=

# --- Azure OpenAI -----------------------------------------------------------
AZURE_OPENAI_ENDPOINT=https://<your-openai-name>.openai.azure.com
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_CHAT_DEPLOYMENT=
AZURE_OPENAI_SMALL_CHAT_DEPLOYMENT=
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=

# --- Azure AI Speech (podcast ASR, plan §7) ---------------------------------
AZURE_SPEECH_ENDPOINT=
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
